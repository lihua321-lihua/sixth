# =============================================================
# 校园热点追踪工具 · 环境变量示例
# 复制本文件为 .env.local 并填入真实值；.env.local 已被 git 忽略，请勿提交真实密钥。
# =============================================================

# ---------- Supabase ----------
# 项目设置 → API 中获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# 新版 publishable key（sb_publishable_ 开头）；旧项目可改用 NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# 旧版 anon key（可选，仅当 publishable key 不可用时作降级）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 服务角色密钥（service_role），仅服务端使用（演示登录、管理操作）；务必保密
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- AI（DeepSeek 为主，OpenAI 兼容接口） ----------
DEEPSEEK_API_KEY=your-deepseek-api-key
# deepseek-chat 为默认，可覆盖
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 以下为 OpenAI 兼容备用（可选），缺失时降级为启发式结果
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# ---------- 邮件发送（QQ SMTP 为主，Resend 备用） ----------
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465
QQ_EMAIL_USER=your-qq-email@qq.com
QQ_EMAIL_PASS=your-qq-smtp-auth-code
# 备用邮件服务（可选）
RESEND_API_KEY=
RESEND_FROM=campus-digest@resend.dev

# ---------- 演示登录账号（可选，有默认值） ----------
DEMO_EMAIL=
DEMO_PASSWORD=

# ---------- 定时任务 ----------
# 定时任务鉴权密钥（Netlify Scheduled Functions 调用 /api/cron/tick 时携带）
CRON_SECRET=your-cron-secret
# 站点访问地址，用于定时任务/邮件回链
SITE_URL=http://localhost:3000